{
  "name": "mentorassistance",
  "version": "1.0.0",
  "description": "A Chrome extension that generates personalized mentor responses for CodeMentor using AI. The responses sound like your actual voice — casual, direct, opinionated, with specific technical opinions and signature phrases.",
  "main": "background.js",
  "scripts": {
    "build": "npm run build:all",
    "build:watch": "tsc --watch",
    "build:env": "tsx build.ts",
    "build:all": "npm run build:tsc && npm run build:env",
    "build:tsc": "tsc",
    "test": "node test_benchmark.js",
    "typecheck": "tsc --noEmit"
  },
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richardokonicha/mentorassistance.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/richardokonicha/mentorassistance/issues"
  },
  "homepage": "https://github.com/richardokonicha/mentorassistance#readme",
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.7.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
